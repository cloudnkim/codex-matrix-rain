+#[test]
+fn matrix_rain_marks_only_unwritten_output_and_keeps_copy_selection() {
+    use crate::matrix_rain::EMPTY_OUTPUT_CELL;
+    use crate::matrix_rain::MatrixRain;
+    use ratatui::style::Modifier;
+
+    let cells = vec![cell("A \t漢 B")];
+    let area = Rect::new(0, 0, 24, 4);
+    let mut view = TranscriptView::default();
+    view.mark_empty_output_cells(true);
+    let mut buf = Buffer::empty(area);
+    view.render(area, &mut buf, &cells);
+    let han = (area.top()..area.bottom())
+        .flat_map(|y| (area.left()..area.right()).map(move |x| (x, y)))
+        .find(|&(x, y)| buf[(x, y)].symbol() == "漢")
+        .expect("wide output should be visible");
+    assert_eq!(buf[(han.0 + 1, han.1)].symbol(), " ");
+    assert_eq!(buf[(han.0 - 1, han.1)].symbol(), " ");
+    view.begin_selection(&cells, /*column*/ 0, han.1, /*clicks*/ 3);
+    let copied = view.selected_text(&cells);
+    assert!(copied.as_deref().is_some_and(|text| text.contains("漢")));
+    view.render(area, &mut buf, &cells);
+    MatrixRain::for_test().render(area, &mut buf, &[]);
+    assert_eq!(view.selected_text(&cells), copied);
+    assert_eq!(buf[(han.0 + 1, han.1)].symbol(), " ");
+    assert_eq!(buf[(han.0 - 1, han.1)].symbol(), " ");
+    assert!(
+        buf.content
+            .iter()
+            .all(|cell| cell.symbol() != EMPTY_OUTPUT_CELL)
+    );
+    assert!(
+        buf.content
+            .iter()
+            .any(|cell| cell.modifier.contains(Modifier::REVERSED))
+    );
+    view.mark_empty_output_cells(false);
+    view.render(area, &mut buf, &cells);
+    assert!(
+        buf.content
+            .iter()
+            .all(|cell| cell.symbol() != EMPTY_OUTPUT_CELL)
+    );
+}
