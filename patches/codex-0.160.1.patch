+#[test]
+fn matrix_rain_output_clips_tiny_views_and_consumes_resize_sentinels() {
+    use crate::matrix_rain::EMPTY_OUTPUT_CELL;
+    use crate::matrix_rain::MatrixRain;
+    use ratatui::widgets::Clear;
+    use ratatui::widgets::Widget;
+
+    let cells = vec![cell("漢 a\ttext")];
+    let rain = MatrixRain::for_test();
+    for width in [0, 1] {
+        for height in 0..=4 {
+            let area = Rect::new(0, 0, width, height);
+            let mut buf = Buffer::empty(area);
+            let mut view = TranscriptView::default();
+            view.mark_empty_output_cells(true);
+            view.render(area, &mut buf, &cells);
+            let occupied = buf
+                .content
+                .iter()
+                .filter(|cell| cell.symbol() != EMPTY_OUTPUT_CELL)
+                .map(|cell| cell.symbol().to_owned())
+                .collect::<Vec<_>>();
+            rain.render(area, &mut buf, &[]);
+            assert!(
+                buf.content
+                    .iter()
+                    .all(|cell| cell.symbol() != EMPTY_OUTPUT_CELL)
+            );
+            for symbol in occupied {
+                assert!(buf.content.iter().any(|cell| cell.symbol() == symbol));
+            }
+        }
+    }
+
+    let full = Rect::new(0, 0, 12, 6);
+    let short = Rect::new(0, 0, 12, 3);
+    let mut buf = Buffer::empty(full);
+    let mut view = TranscriptView::default();
+    view.mark_empty_output_cells(true);
+    view.render(full, &mut buf, &cells);
+    Clear.render(Rect::new(0, 3, 12, 3), &mut buf);
+    view.render(short, &mut buf, &cells);
+    rain.render(short, &mut buf, &[]);
+    assert!(
+        buf.content
+            .iter()
+            .all(|cell| cell.symbol() != EMPTY_OUTPUT_CELL)
+    );
+}
