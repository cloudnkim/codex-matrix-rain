+#[test]
+#[ignore = "manual render cost probe; run separately from the native build"]
+fn matrix_rain_output_render_performance() {
+    use crate::matrix_rain::MatrixRain;
+
+    let cells = (0..1000)
+        .map(|index| cell(format!("{index:04}  결과 漢字 tab\tcode()  answer text")))
+        .collect::<Vec<_>>();
+    let rain = MatrixRain::for_test();
+    for (width, height) in [(120, 40), (240, 80)] {
+        let area = Rect::new(0, 0, width, height);
+        let mut baseline = TranscriptView::default();
+        let mut animated = TranscriptView::default();
+        animated.mark_empty_output_cells(true);
+        let mut baseline_buf = Buffer::empty(area);
+        let mut animated_buf = Buffer::empty(area);
+        for _ in 0..5 {
+            baseline.render(area, &mut baseline_buf, &cells);
+            animated.render(area, &mut animated_buf, &cells);
+            rain.render(area, &mut animated_buf, &[]);
+        }
+        baseline.begin_selection(&cells, /*column*/ 0, /*row*/ 0, /*clicks*/ 3);
+        animated.begin_selection(&cells, /*column*/ 0, /*row*/ 0, /*clicks*/ 3);
+        assert_eq!(
+            baseline.selected_text(&cells),
+            animated.selected_text(&cells)
+        );
+        for (label, view, buf) in [
+            ("baseline", &mut baseline, &mut baseline_buf),
+            ("rain", &mut animated, &mut animated_buf),
+        ] {
+            let mut samples = Vec::with_capacity(200);
+            for _ in 0..200 {
+                let started = std::time::Instant::now();
+                view.render(area, buf, &cells);
+                if label == "rain" {
+                    rain.render(area, buf, &[]);
+                }
+                samples.push(started.elapsed().as_micros());
+            }
+            samples.sort_unstable();
+            let mean = samples.iter().sum::<u128>() / samples.len() as u128;
+            let p95 = samples[samples.len() * 95 / 100];
+            println!(
+                "matrix_rain_output_render_performance {width}x{height} {label}: mean={mean}us p95={p95}us"
+            );
+        }
+    }
+}
